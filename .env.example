DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
SESSION_SECRET="replace-with-openssl-rand-base64-32"
APP_URL="https://status.example.com"

# Evolution API
EVOLUTION_API_URL="https://whatsapp.example.com"
EVOLUTION_API_KEY="replace-with-api-key"
EVOLUTION_INSTANCE="replace-with-instance-name"
EVOLUTION_WEBHOOK_SECRET="replace-with-random-webhook-secret"

# SMTP
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="notifications@example.com"
SMTP_PASSWORD="replace-with-smtp-password"

# One-time initial seed only; remove from production after seeding
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="replace-with-temporary-password"
SEED_MANAGER_EMAIL="manager@example.com"
SEED_MANAGER_PASSWORD="replace-with-temporary-password"
SEED_CLIENT_EMAIL="client@example.com"
SEED_CLIENT_PASSWORD="replace-with-temporary-password"
